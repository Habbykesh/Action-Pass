{
  "name": "actionfi-partnership-bot",
  "version": "1.0.0",
  "description": "ActionFi Partnership Verification Bot - cross-server membership verification, campaign management, and eligibility reporting.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "deploy-commands": "node src/deploy-commands.js",
    "postinstall": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@prisma/client": "^5.18.0",
    "date-fns": "^3.6.0",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "json2csv": "^6.0.0-alpha.2",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "pg": "^8.23.1",
    "prisma": "^5.18.0"
  }
}
