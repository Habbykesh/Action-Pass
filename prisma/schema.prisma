generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  active
  ended
  archived
}

// One row, singleton. Bot-wide settings.
model BotSettings {
  id                 Int     @id @default(1)
  globalPartnerAccess Boolean @default(false)
}

// Per-Discord-server configuration: single log channel + explicit
// campaign-access override.
model GuildConfig {
  id             Int      @id @default(autoincrement())
  guildId        String   @unique
  guildName      String?
  logChannelId   String?
  campaignAccess Boolean  @default(false)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

model Campaign {
  id              String   @id @default(cuid())
  name            String
  ownerGuildId    String
  createdByUserId String

  roleServerId    String
  roleId          String
  roleName        String
  roleAutoCreated Boolean  @default(true)

  startAt    DateTime
  deadlineAt DateTime

  status CampaignStatus @default(active)

  verificationActivityCount Int @default(0)

  endedAt        DateTime?
  endedByUserId  String?
  archivedAt     DateTime?

  requiredServers RequiredServer[]
  postedEmbeds    PostedEmbed[]
  members         CampaignMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerGuildId, status])
}

// One row per server required by a campaign (min 2 per campaign,
// enforced in application code).
model RequiredServer {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  guildId    String
  name       String
  inviteLink String

  @@index([campaignId])
  @@index([guildId])
}

// One row per verification embed message posted into a participating
// server, so it can be edited/reposted/tracked later.
model PostedEmbed {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  guildId   String
  channelId String
  messageId String

  @@index([campaignId])
}

// Per-user eligibility record for a given campaign. Discord User ID is
// the durable identifier; username is a display snapshot only, since
// usernames can change.
model CampaignMember {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  userId           String
  lastKnownUsername String?

  // The guild whose Verify embed this member first clicked — an
  // attribution signal for which partner community actually drove the
  // crossover, not a claim about which server they "belong to."
  sourceGuildId String?

  // JSON map of guildId -> boolean membership status from the last check.
  serverStatus Json @default("{}")

  eligible       Boolean @default(false)
  roleAssigned   Boolean @default(false)

  firstVerifiedAt DateTime?
  lastCheckedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([campaignId, userId])
  @@index([campaignId, eligible])
}

// A member's self-claimed identity, linked once and locked — separate
// from Discord's own display name/tag, which can change. Global (not
// per-campaign) since it's a person's identity, not campaign data.
model LinkedUsername {
  id            String   @id @default(cuid())
  discordUserId String   @unique

  // Display casing is preserved; usernameLower enforces case-insensitive
  // uniqueness so "Habbykesh" and "habbykesh" can't both be claimed.
  username      String
  usernameLower String   @unique

  // True until an admin overrides it — self-service linking only ever
  // sets this once and then refuses further self-edits.
  lockedByUser  Boolean  @default(true)
  setByAdminId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Action Model: Alpha Gate + Verification Gate ───────────────────
// Everything below is scoped to a single Discord server (the Action
// Model server, enforced in application code via ACTION_MODEL_GUILD_ID)
// and is completely independent of the cross-server Campaign system
// above — no LinkedUsername is required for either feature.

// Singleton row (guildId unique) holding the Action Model verification
// panel's configurable wording/roles and the posted-message location so
// /setup can edit the existing panel in place instead of reposting.
model ActionModelSettings {
  id      Int    @id @default(1)
  guildId String @unique

  embedTitle       String  @default("ACTION MODEL")
  embedDescription String  @default("Complete verification below to get access.")
  embedImageUrl    String?

  verifyButtonLabel   String  @default("✅ Verify")
  verificationRoleId  String?

  campaignButtonLabel String  @default("🏆 Alpha Winners")
  campaignRoleId      String?
  campaignRoleName    String?

  panelChannelId String?
  panelMessageId String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// One-time-use Alpha/WL access codes. The role is snapshotted onto each
// code at generation time, so changing /setup's campaign role for a
// future campaign never changes what an already-printed, still-unused
// code grants.
model AccessCode {
  id      String @id @default(cuid())
  guildId String

  code      String @unique
  codeUpper String @unique

  roleId   String
  roleName String

  used         Boolean   @default(false)
  usedByUserId String?
  usedByName   String?
  usedAt       DateTime?

  createdByUserId String
  createdAt       DateTime @default(now())

  @@index([guildId, used])
}

// ── Action Model: Role Panels ───────────────────────────────────────
// Generic, reusable button-based role selection — not hardcoded to any
// one category (region, interest, language, game, etc). Scoped to the
// Action Model server, same as the Alpha/Verification Gate above.

model RolePanel {
  id      String @id @default(cuid())
  guildId String

  // Admin-chosen slug used to select this panel from /role-panel edit,
  // delete, repost — must stay stable so it can always be re-selected.
  internalName String
  title        String
  description  String

  // Null until the panel has been posted for the first time via
  // /role-panel repost.
  channelId String?
  messageId String?

  createdByUserId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  buttons RolePanelButton[]

  @@unique([guildId, internalName])
}

model RolePanelButton {
  id      String    @id @default(cuid())
  panelId String
  panel   RolePanel @relation(fields: [panelId], references: [id], onDelete: Cascade)

  label String
  emoji String?
  // Primary | Secondary | Success | Danger — validated in application
  // code before being mapped to discord.js's ButtonStyle enum.
  style String

  roleId   String
  // Snapshotted at add-time purely for display in admin UI; the live
  // Discord role is always re-checked at click/post time so a renamed
  // or deleted role is never silently trusted.
  roleName String

  position Int

  @@index([panelId])
}
